# Copy this file to .env.local and fill in your Supabase project credentials:

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Set to false for clean database mode, or true to preview with demo entries locally
NEXT_PUBLIC_ENABLE_SEED_DATA=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin account email (authorized to access /admin and moderation console)
ADMIN_EMAIL=admin@lelamrank.in

