# ==============================================================================
# LELAM RANK — Production & Local Environment Configuration
# Tagline: "Bid. Rank. Rise."
# Positioning: "Where Kerala startups, businesses and digital products compete for the top."
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL & AUTHENTICATION
# ------------------------------------------------------------------------------
# Obtained from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Secret Service Role Key strictly for server-side trusted operations & webhooks.
# NEVER prefix with NEXT_PUBLIC_. Keep private.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. RAZORPAY TEST MODE CREDENTIALS
# ------------------------------------------------------------------------------
# Obtained from: Razorpay Dashboard (Test Mode) -> Settings -> API Keys & Webhooks
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_key

# ------------------------------------------------------------------------------
# 3. PRODUCTION SEED DATA ISOLATION
# ------------------------------------------------------------------------------
# Set to 'false' in production so the leaderboard starts with a clean slate
# and only displays verified database records.
# Set to 'true' in development only if you want local demo startups visible.
NEXT_PUBLIC_ENABLE_SEED_DATA=false

# ------------------------------------------------------------------------------
# 4. APP & REDIRECT DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Production: https://lelam-rank.vercel.app (or custom domain)
# Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://lelam-rank.vercel.app
NEXT_PUBLIC_APP_URL=https://lelam-rank.vercel.app
NEXT_PUBLIC_MIN_BID=50

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=updates@lelamrank.in

# ------------------------------------------------------------------------------
# 6. ADMIN ACCOUNT CONFIGURATION (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Email address granted authoritative access to /admin and moderation APIs
ADMIN_EMAIL=admin@lelamrank.in

